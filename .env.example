# ─── AuthHub Production Configuration ───
PORT=4100
NODE_ENV=production

# Kunci rahasia kriptografi untuk menandatangani JWT (Ganti dengan string acak panjang di production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# Domain issuer token JWT (misal: auth.josapratama.com)
AUTH_HUB_ISSUER=auth-hub.josapratama.com

# Lokasi file database JSON persistensi
AUTH_HUB_DB_FILE=/app/data/auth-store.json
