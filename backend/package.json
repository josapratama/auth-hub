{
  "name": "auth-hub-backend",
  "version": "1.0.0",
  "description": "Centralized Identity, OAuth2/SSO & Multi-Project RBAC Engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:all": "npm run build && cd ../frontend && npm run build"
